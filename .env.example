NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# TikTok Shop Partner Center — jangan expose ke client
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://www.larisin.site/api/auth/tiktok/callback

# 32 byte random key, base64-encoded (mis. `openssl rand -base64 32`)
TOKEN_ENCRYPTION_KEY=

# Melindungi /api/tiktok/token/refresh dari dipanggil sembarang orang.
# Vercel otomatis kirim header ini saat cron job jalan kalau var ini diset.
CRON_SECRET=
